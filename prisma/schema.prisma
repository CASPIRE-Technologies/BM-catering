datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// User & Authentication Models
// ----------------------------------------------------
enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]

}

// ----------------------------------------------------
// Customer CRM Model
// ----------------------------------------------------
model Customer {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  whatsapp  String?
  email     String?
  address   String?
  notes     String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([phone])
  @@index([email])
}

// ----------------------------------------------------
// Service Catalog (Catering, Rentals, Lighting/Decor)
// ----------------------------------------------------
model ServiceCategory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  categoryId      String          @db.ObjectId
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  slug            String          @unique
  description     String
  basePrice       Float           @default(0)
  pricingUnit     String          @default("PER_PERSON") // PER_PERSON, PER_EVENT, PACKAGE
  imageUrl        String?
  features        String?         // Stored as JSON or comma separated string
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(true)
  bookingServices BookingService[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categoryId])
}

// ----------------------------------------------------
// Inventory & Equipment Rentals
// ----------------------------------------------------
model InventoryCategory {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        String          @unique
  slug        String          @unique
  description String?
  sortOrder   Int             @default(0)
  items       InventoryItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum ItemCondition {
  BRAND_NEW
  EXCELLENT
  GOOD
  FAIR
  NEEDS_REPAIR
}

enum ItemStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

model InventoryItem {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  categoryId         String              @db.ObjectId
  category           InventoryCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name               String
  sku                String              @unique
  description        String?
  imageUrl           String?
  totalQuantity      Int                 @default(0)
  rentalPrice        Float               @default(0)
  pricingUnit        String              @default("PER_DAY") // PER_DAY, PER_EVENT, PER_PIECE
  condition          ItemCondition       @default(EXCELLENT)
  status             ItemStatus          @default(AVAILABLE)
  damagedQuantity    Int                 @default(0)
  maintenanceQuantity Int                @default(0)
  bookingItems       BookingItem[]
  movements          InventoryMovement[]
  maintenanceRecords MaintenanceRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([categoryId])
  @@index([status])
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  MAINTENANCE_SEND
  MAINTENANCE_RETURN
  DAMAGED_WRITE_OFF
  ADJUSTMENT
}

model InventoryMovement {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  itemId      String        @db.ObjectId
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        MovementType
  quantity    Int
  reason      String?
  referenceId String?
  performedBy String?
  createdAt   DateTime      @default(now())

  @@index([itemId])
}

enum MaintenanceStatus {
  IN_REPAIR
  COMPLETED
  SCRAPPED
}

model MaintenanceRecord {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  itemId      String            @db.ObjectId
  item        InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Int               @default(1)
  issue       String
  cost        Float             @default(0)
  status      MaintenanceStatus @default(IN_REPAIR)
  startDate   DateTime          @default(now())
  returnDate  DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([itemId])
  @@index([status])
}

// ----------------------------------------------------
// Bookings & Multi-Service Aggregations
// ----------------------------------------------------
enum BookingStatus {
  ENQUIRY
  QUOTATION_SENT
  PENDING_CONFIRMATION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Booking {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  bookingNumber  String         @unique
  customerId     String         @db.ObjectId
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  eventType      String         // Wedding, Birthday, Corporate, Festival, etc.
  eventLocation  String
  startDate      DateTime
  endDate        DateTime
  status         BookingStatus  @default(ENQUIRY)
  
  // Independent Service Amounts
  cateringAmount Float          @default(0)
  rentalAmount   Float          @default(0)
  lightingAmount Float          @default(0)
  discount       Float          @default(0)
  totalAmount    Float          @default(0)
  advanceAmount  Float          @default(0)
  paidAmount     Float          @default(0)
  
  guestCount     Int?
  notes          String?
  adminNotes     String?
  
  items          BookingItem[]
  services       BookingService[]
  payments       Payment[]
  auditLogs      AuditLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([startDate, endDate])
}

enum DispatchStatus {
  PENDING
  PREPARED
  DISPATCHED
  RETURNED_PARTIAL
  RETURNED_FULL
}

model BookingItem {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  bookingId       String         @db.ObjectId
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemId          String         @db.ObjectId
  item            InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity        Int
  rentalRate      Float          @default(0)
  subtotal        Float          @default(0)
  dispatchStatus  DispatchStatus @default(PENDING)
  returnedQty     Int            @default(0)
  damagedQuantity Int            @default(0)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([bookingId])
  @@index([itemId])
}

model BookingService {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String   @db.ObjectId
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   String?  @db.ObjectId
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceType String   // CATERING, LIGHTING, DECORATION, OTHER
  name        String
  amount      Float    @default(0)
  details     String?  // JSON string or notes for menu choices, guest count, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookingId])
}

// ----------------------------------------------------
// Payments & Cash Flow
// ----------------------------------------------------
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  CHEQUE
  ONLINE_GATEWAY
}

model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  paymentNumber String        @unique
  bookingId     String        @db.ObjectId
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount        Float         @default(0)
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  paymentDate   DateTime      @default(now())
  reference     String?       // Slip number, bank ref
  notes         String?
  recordedBy    String?
  createdAt     DateTime      @default(now())

  @@index([bookingId])
  @@index([paymentDate])
}

// ----------------------------------------------------
// Operating Expenses
// ----------------------------------------------------
model Expense {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  expenseNumber String   @unique
  category      String   // INGREDIENTS, FUEL_TRANSPORT, STAFF_WAGES, EQUIPMENT_MAINTENANCE, DECORATIONS, UTILITIES, MISC
  title         String
  amount        Float    @default(0)
  date          DateTime @default(now())
  description   String?
  vendor        String?
  receiptUrl    String?
  recordedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([date])
}

// ----------------------------------------------------
// Gallery Images
// ----------------------------------------------------
model GalleryImage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  category    String   // CATERING, EQUIPMENT, LIGHTING, WEDDINGS, CORPORATE
  imageUrl    String
  description String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ----------------------------------------------------
// Website Content & Dynamic Settings
// ----------------------------------------------------
model WebsiteContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  section   String   @unique // HERO, ABOUT, STATS, TESTIMONIALS, SETTINGS
  title     String
  subtitle  String?
  content   Json
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// Audit Logging
// ----------------------------------------------------
model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  action      String   // CREATE_BOOKING, UPDATE_STATUS, RECORD_PAYMENT, etc.
  entity      String   // BOOKING, INVENTORY, PAYMENT, etc.
  entityId    String?
  details     Json?
  performedBy String?
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingId   String?  @db.ObjectId
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
